#!/bin/sh
# Use the bundled dependencies on Matthew's Mac; portable hosts can set NFL_PDF_PYTHON.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime="${NFL_PDF_PYTHON:-$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3}"
if [ ! -x "$runtime" ]; then runtime=python3; fi
exec "$runtime" -B "$dir/brief.py" "$@"
